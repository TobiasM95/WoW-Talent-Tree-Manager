{
  "name": "ttm-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "shots": "node shot.mjs",
    "test": "node interact.mjs",
    "test:share": "node share.test.mjs",
    "test:all": "npm run typecheck && npm run test:share && npm run test:loadout && npm run test:string && npm run test:simc && npm test && npm run test:bugs && npm run test:bridge",
    "test:loadout": "node loadout.test.mjs",
    "test:string": "node loadoutString.test.mjs",
    "test:simc": "node simc.test.mjs",
    "test:bugs": "node bugs.test.mjs",
    "test:bridge": "node bridge.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
