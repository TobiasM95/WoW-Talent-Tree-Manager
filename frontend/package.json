{
  "name": "ttm-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.1.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||'';if(!ua.startsWith('pnpm')){console.error('This project uses pnpm. Run: corepack enable && pnpm install');process.exit(1)}\"",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "shots": "node shot.mjs",
    "test": "node workflow.test.mjs",
    "test:share": "node share.test.mjs",
    "test:all": "pnpm run typecheck && pnpm run test:share && pnpm run test:loadout && pnpm run test:string && pnpm run test:simc && pnpm run test:report && pnpm run test:canvas && pnpm run test:forever && pnpm run test:editor && pnpm run test:popular && pnpm test",
    "test:loadout": "node loadout.test.mjs",
    "test:string": "node loadoutString.test.mjs",
    "test:simc": "node simc.test.mjs",
    "test:report": "node simcReport.test.mjs",
    "test:canvas": "node canvas.test.mjs",
    "test:forever": "node forever.test.mjs",
    "test:editor": "node editor.test.mjs",
    "test:popular": "node popular.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
